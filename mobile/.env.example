# Copiez ce fichier en « .env » et remplissez-le pour activer la connexion Google.
# Laissé vide, l'application demande l'URL du script et la clé d'accès.

# URL de l'application Web Apps Script (se termine par /exec)
EXPO_PUBLIC_API_URL=

# Google Cloud Console > Identifiants > ID client OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
