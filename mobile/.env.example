# Facultatif : identifiants Google Cloud (projet « Mes taches »). L'ID client web est déjà intégré à
# l'application ; ce fichier ne sert qu'à le remplacer, ou pour l'application iPhone.

# Google Cloud Console > Google Auth Platform > Clients > ID client « Application Web »
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# ID client « iOS » (application iPhone)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
